{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:crossbow/pull",
      "entries": [
        {
          "threshold": 0,
          "model": {
            "type": "minecraft:model",
            "model": "mobarmy:item/ranger_crossbow_pulling_0"
          }
        },
        {
          "threshold": 0.58,
          "model": {
            "type": "minecraft:model",
            "model": "mobarmy:item/ranger_crossbow_pulling_1"
          }
        },
        {
          "threshold": 1,
          "model": {
            "type": "minecraft:model",
            "model": "mobarmy:item/ranger_crossbow_pulling_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "mobarmy:item/ranger_crossbow"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "mobarmy:item/ranger_crossbow_arrow"
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "mobarmy:item/ranger_crossbow_rocket"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "mobarmy:item/ranger_crossbow"
      }
    }
  }
}
